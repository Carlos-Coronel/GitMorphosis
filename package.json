{
  "name": "gitmorphosis",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Generate stunning GitHub profile READMEs automatically — no API key needed",
  "author": "Carlos Coronel",
  "license": "MIT",
  "homepage": "https://github.com/Carlos-Coronel/GitMorphosis",
  "repository": {
    "type": "git",
    "url": "https://github.com/Carlos-Coronel/GitMorphosis.git"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "build:pages": "cross-env NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_REPO_NAME=GitMorphosis NODE_ENV=production next build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "dead-code": "knip",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm dead-code && pnpm type-check && pnpm test:coverage && pnpm build:pages",
    "clean": "node -e \"for (const path of ['.next', 'out', '.e2e-site', 'coverage', 'playwright-report', 'test-results', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.564.0",
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
